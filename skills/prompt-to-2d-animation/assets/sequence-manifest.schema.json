{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumio.games/schemas/sequence-manifest-0.1.0.json",
  "title": "Lumio 2D Animation Sequence Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "clip_id",
    "animation_kind",
    "width",
    "height",
    "fps",
    "duration_seconds",
    "loop",
    "alpha",
    "pivot",
    "frame_count",
    "frames",
    "atlas_pages",
    "approx_rgba_bytes"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "clip_id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
    },
    "animation_kind": {"const": "flipbook"},
    "width": {"type": "integer", "minimum": 1},
    "height": {"type": "integer", "minimum": 1},
    "fps": {"type": "number", "exclusiveMinimum": 0},
    "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
    "loop": {"type": "boolean"},
    "alpha": {"type": "boolean"},
    "pivot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": {"type": "number"},
        "y": {"type": "number"}
      }
    },
    "frame_count": {"type": "integer", "minimum": 1, "maximum": 48},
    "frames": {
      "type": "array",
      "minItems": 1,
      "maxItems": 48,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "file", "region", "duration_seconds"],
        "properties": {
          "index": {"type": "integer", "minimum": 0},
          "file": {"type": "string"},
          "region": {"type": "string"},
          "duration_seconds": {"type": "number", "exclusiveMinimum": 0}
        }
      }
    },
    "atlas_pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "width", "height", "region_count"],
        "properties": {
          "file": {"type": "string"},
          "width": {"type": "integer", "minimum": 1},
          "height": {"type": "integer", "minimum": 1},
          "region_count": {"type": "integer", "minimum": 1}
        }
      }
    },
    "approx_rgba_bytes": {"type": "integer", "minimum": 1}
  }
}
